if (EXPECT_COPY)
  if (NOT EXISTS "${OUTPUT_FILE}")
    message(FATAL_ERROR "The NVML fixture DLL was not copied")
  endif()
  file(SHA256 "${INPUT_FILE}" input_hash)
  file(SHA256 "${OUTPUT_FILE}" output_hash)
  if (NOT input_hash STREQUAL output_hash)
    message(FATAL_ERROR "The copied NVML fixture DLL does not match")
  endif()
elseif (EXISTS "${OUTPUT_FILE}")
  message(FATAL_ERROR "The NVML fixture DLL should not be copied")
endif()
