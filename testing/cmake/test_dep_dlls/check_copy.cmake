if (EXPECT_COPY)
  if (NOT EXISTS "${OUTPUT_FILE}")
    message(FATAL_ERROR "The fixture DLL was not copied to '${OUTPUT_FILE}'")
  endif()
  file(SHA256 "${INPUT_FILE}" input_hash)
  file(SHA256 "${OUTPUT_FILE}" output_hash)
  if (NOT input_hash STREQUAL output_hash)
    message(FATAL_ERROR "The copied fixture DLL does not match '${INPUT_FILE}'")
  endif()
elseif (EXISTS "${OUTPUT_FILE}")
  message(FATAL_ERROR "The fixture DLL should not be copied to '${OUTPUT_FILE}'")
endif()
