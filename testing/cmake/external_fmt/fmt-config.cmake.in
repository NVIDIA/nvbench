set(fmt_VERSION "12.2.0")

add_library(external_fmt STATIC "@FMT_SOURCE_DIR@/src/format.cc")
target_include_directories(external_fmt SYSTEM PUBLIC "@FMT_SOURCE_DIR@/include")
target_compile_features(external_fmt PUBLIC cxx_std_11)
set_target_properties(external_fmt PROPERTIES
  POSITION_INDEPENDENT_CODE ON
)
add_library(fmt::fmt ALIAS external_fmt)
